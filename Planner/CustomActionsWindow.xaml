<Window x:Class="VisualControlsBinder.Planner.CustomActionsWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CUSTOM TO VJOY ACTIONS" Width="745" Height="525" MinWidth="590" MinHeight="375"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI" FontSize="14">
  <DockPanel Margin="22">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="CUSTOM TO VJOY ACTIONS" FontFamily="Bahnschrift, Segoe UI" FontSize="22" FontWeight="Bold" />
      <Grid Margin="6,13,34,0" TextElement.FontWeight="Bold">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
        <TextBlock Text="CATEGORY" />
        <TextBlock Grid.Column="1" Text="ACTION" />
        <TextBlock Grid.Column="2" Text="INPUT" />
      </Grid>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="EditorStatus" TextWrapping="Wrap" Foreground="{StaticResource ShiftAccent}" Margin="0,0,0,6" />
      <DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
          <Button Content="Cancel" IsCancel="True" Margin="0,0,7,0" />
          <Button Content="Save actions" IsDefault="True" Click="SaveActions" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Content="Add action" Click="AddAction" Margin="0,0,7,0" />
          <Button Content="Import list…" Click="ImportActions" />
        </StackPanel>
      </DockPanel>
    </StackPanel>
    <ListBox x:Name="ActionList" AutomationProperties.Name="Custom action list">
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Focusable" Value="False" />
          <Setter Property="Padding" Value="0,3" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
            <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" AutomationProperties.Name="Category" />
            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" AutomationProperties.Name="Action name" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding InputTypes}" SelectedItem="{Binding InputType, Mode=TwoWay}"
                      Margin="0,0,6,0" AutomationProperties.Name="Input type" />
            <Button Grid.Column="3" Content="×" Padding="0" MinHeight="30" Click="RemoveAction"
                    ToolTip="Remove this action" AutomationProperties.Name="Remove action" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
