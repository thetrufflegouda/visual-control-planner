<Window x:Class="VisualControlsBinder.Planner.DeviceLibraryWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DEVICE LIBRARY" Width="1060" Height="698" MinWidth="630" MinHeight="390"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI" FontSize="14">
  <DockPanel Margin="22">
    <TextBlock DockPanel.Dock="Top" Text="DEVICE LIBRARY" FontFamily="Bahnschrift, Segoe UI"
               FontSize="22" FontWeight="Bold" Margin="0,0,0,14" />
    <TabControl x:Name="LibraryTabs" DockPanel.Dock="Top" Margin="0,0,0,14" SelectionChanged="SelectLibraryTab">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <TabPanel IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" />
        </ControlTemplate>
      </TabControl.Template>
      <TabControl.ItemContainerStyle>
        <Style TargetType="TabItem">
          <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
          <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI" />
          <Setter Property="FontWeight" Value="SemiBold" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border x:Name="Tab" Margin="0,0,6,0" Padding="14,8" CornerRadius="5"
                        Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                  <ContentPresenter ContentSource="Header" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tab" Property="Background" Value="{StaticResource HoverBackground}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter TargetName="Tab" Property="Background" Value="{StaticResource SelectionBackground}" />
                    <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Accent}" />
                  </Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Accent}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.ItemContainerStyle>
      <TabItem Header="ALL DEVICES" IsSelected="True" />
      <TabItem x:Name="MyDevicesTab" Header="MY DEVICES" />
    </TabControl>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="OwnedDeviceButton" Content="Add to My Devices" IsEnabled="False"
                Click="ToggleOwnedDevice" Margin="0,0,8,0" />
        <Button x:Name="AddButton" Content="Add to plan" IsDefault="True" IsEnabled="False"
                Style="{StaticResource PrimaryButton}" Click="AddDevice" />
      </StackPanel>
      <TextBlock x:Name="LibraryStatus" Foreground="{StaticResource TextSecondary}"
                 VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
    </DockPanel>
    <Border DockPanel.Dock="Left" Width="158" Margin="0,0,15,0" Padding="9,12,9,8"
            Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1" CornerRadius="7">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="MANUFACTURERS" FontFamily="Bahnschrift, Segoe UI"
                   FontWeight="SemiBold" FontSize="12" Margin="6,0,0,10"
                   Foreground="{StaticResource TextSecondary}" />
        <ListBox x:Name="Manufacturers" AutomationProperties.Name="Manufacturers"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="FilterByManufacturer">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid>
    <ListBox x:Name="DeviceGrid" AutomationProperties.Name="Device library"
             SelectionChanged="SelectDevice" MouseDoubleClick="OpenTile"
             Loaded="PreviewVisibilityChanged" SizeChanged="PreviewVisibilityChanged"
             ScrollViewer.ScrollChanged="PreviewVisibilityChanged"
             ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel ItemWidth="190" ItemHeight="176" KeyboardNavigation.DirectionalNavigation="Contained" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Margin" Value="0,0,10,10" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="ToolTip" Value="{Binding Caption}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding Caption}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Tile" CornerRadius="7" BorderThickness="1" BorderBrush="{StaticResource PanelBorder}"
                        Background="{StaticResource PanelBackground}" Padding="11">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource HoverBackground}" />
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource ControlOutline}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{StaticResource SelectionBackground}" />
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}" />
                  </Trigger>
                  <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="43" />
            </Grid.RowDefinitions>
            <ContentPresenter Content="{Binding Preview}" Margin="2,2,2,6" IsHitTestVisible="False" />
            <TextBlock Grid.Row="1" Text="{Binding Caption}" FontFamily="Bahnschrift, Segoe UI"
                       FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       TextAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="EmptyMyDevices" Text="Add a controller from All Devices to start your list."
               Visibility="Collapsed" IsHitTestVisible="False" Foreground="{StaticResource TextSecondary}"
               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="18" />
    </Grid>
  </DockPanel>
</Window>
