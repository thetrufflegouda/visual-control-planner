<Window x:Class="VisualControlsBinder.Planner.VJoyPatchBayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VJOY PATCH BAY" Width="900" Height="680" MinWidth="640" MinHeight="385"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI" PreviewKeyDown="PatchBayKeyDown">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,17">
      <ComboBox x:Name="KindPicker" DockPanel.Dock="Right" Width="115" VerticalAlignment="Top"
                SelectionChanged="FilterChanged" AutomationProperties.Name="Input kind" />
      <StackPanel>
        <TextBlock Text="VJOY PATCH BAY" FontWeight="SemiBold" FontSize="21" />
        <TextBlock x:Name="GameCaption" Style="{StaticResource SecondaryText}" Margin="0,4,12,0" />
        <TextBlock x:Name="GremlinShiftCaption" Style="{StaticResource SecondaryText}" Foreground="{StaticResource GremlinShiftAccent}"
                   Visibility="Collapsed" Margin="0,4,12,0" />
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,7">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="116" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="PHYSICAL INPUTS" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,6" />
        <DockPanel>
          <ComboBox x:Name="LayerFilter" DockPanel.Dock="Right" Width="129" Margin="6,0,0,0" DisplayMemberPath="Label"
                    SelectionChanged="FilterChanged" AutomationProperties.Name="Physical input layer" />
          <ComboBox x:Name="PhysicalDevicePicker" DisplayMemberPath="Name" SelectionChanged="PhysicalDeviceChanged"
                    AutomationProperties.Name="Physical device" />
        </DockPanel>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="VJOY OUTPUTS" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ComboBox x:Name="OutputDevicePicker" DisplayMemberPath="Name" SelectionChanged="FilterChanged"
                  AutomationProperties.Name="vJoy patch bay device" />
      </StackPanel>
    </Grid>
    <Border x:Name="PatchArea" Grid.Row="2" Background="{StaticResource CanvasBackground}" BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1" CornerRadius="6" Padding="9" ClipToBounds="True"
            PreviewMouseLeftButtonDown="PatchMouseDown" PreviewMouseMove="PatchMouseMove"
            PreviewMouseLeftButtonUp="PatchMouseUp" PreviewMouseWheel="PatchMouseWheel" LostMouseCapture="PatchCaptureLost">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="116" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer x:Name="InputScroll" VerticalScrollBarVisibility="Auto" ScrollChanged="PortViewportChanged">
          <StackPanel x:Name="Inputs" />
        </ScrollViewer>
        <ScrollViewer x:Name="OutputScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" ScrollChanged="PortViewportChanged">
          <StackPanel x:Name="Outputs" />
        </ScrollViewer>
        <Canvas x:Name="WireLayer" Grid.ColumnSpan="3" IsHitTestVisible="False" ClipToBounds="True" SizeChanged="WireLayerResized" />
      </Grid>
    </Border>
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
      <Button x:Name="RemoveRouteButton" DockPanel.Dock="Right" Content="Remove route" Click="RemoveRoute"
              IsEnabled="False" Margin="10,0,0,0" />
      <TextBlock x:Name="RouteDetails" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" />
    </DockPanel>
  </Grid>
</Window>
