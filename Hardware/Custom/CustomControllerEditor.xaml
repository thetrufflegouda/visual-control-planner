<Window x:Class="VisualControlsBinder.Hardware.Custom.CustomControllerEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal" Title="CUSTOM CONTROLLER" Width="1040" Height="730"
        MinWidth="760" MinHeight="600" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="14" PreviewKeyDown="EditorKeyDown">
  <Window.Resources>
    <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
      <Setter Property="Background" Value="{StaticResource ControlOutline}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CanvasBackground}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Grip" Background="{TemplateBinding Background}" CornerRadius="3"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Grip" Property="BorderBrush" Value="White"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Grip" Property="BorderBrush" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="255"/><ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid Grid.ColumnSpan="2" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
        <Label Target="{Binding ElementName=ControllerName}" Foreground="{StaticResource TextPrimary}" Padding="0,0,0,5">Controller name</Label>
        <TextBox x:Name="ControllerName" MaxLength="80"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <Label Target="{Binding ElementName=DevicePicker}" Foreground="{StaticResource TextPrimary}" Padding="0,0,0,5">Windows device</Label>
        <ComboBox x:Name="DevicePicker" DisplayMemberPath="Label"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,15,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="Panel" Style="{StaticResource SectionTitle}" Margin="0,0,0,7"/>
        <ComboBox x:Name="ShapePicker" AutomationProperties.Name="Panel shape" SelectionChanged="ChangeShape"/>
        <TextBlock Text="Drag the panel edges to resize." Style="{StaticResource SecondaryText}" Margin="0,6,0,16"/>

        <TextBlock Text="Controls" Style="{StaticResource SectionTitle}" Margin="0,0,0,3"/>
        <TextBlock Text="Drag to the panel or click to add. Select a control to resize it." Style="{StaticResource SecondaryText}" Margin="0,0,0,7"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="Palette">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Label}" Tag="{Binding Kind}" Margin="0,0,0,5" Click="AddFromPalette"
                      PreviewMouseLeftButtonDown="StartPaletteDrag" PreviewMouseMove="DragFromPalette"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Margin="0,6,0,0">
        <StackPanel x:Name="PartTools" Visibility="Collapsed">
          <TextBlock Text="Selected control" Style="{StaticResource SectionTitle}" Margin="0,0,0,7"/>
          <Label Target="{Binding ElementName=SelectedPartName}" Foreground="{StaticResource TextPrimary}" Padding="0,0,0,5">Control name</Label>
          <TextBox x:Name="SelectedPartName" MaxLength="80" IsEnabled="False" LostKeyboardFocus="CommitPartName"/>
          <Button x:Name="RotatePartButton" Content="Rotate 90°" Margin="0,7,0,0" Click="RotateSelectedPart" Visibility="Collapsed"/>
          <Button x:Name="RemoveButton" Content="Remove selected control" Margin="0,7,0,0" Click="RemovePart" IsEnabled="False"
                  ToolTip="Delete or Backspace removes the selected control."/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="8"
            Background="{StaticResource PanelBackground}" Padding="8">
      <Canvas x:Name="PanelWorkspace" ClipToBounds="True" Background="Transparent" Focusable="True"
              AutomationProperties.Name="Controller layout workspace" SizeChanged="WorkspaceSizeChanged"
              ToolTip="Ctrl+C copies the selected control. Ctrl+V pastes a copy.">
        <Border x:Name="PanelOutline" BorderThickness="2" BorderBrush="{StaticResource ControlOutline}" Background="{StaticResource ControlBackground}">
          <Canvas x:Name="PanelSurface" Background="Transparent" AllowDrop="True" DragOver="PreviewPartDrop"
                  Drop="DropPart" MouseLeftButtonDown="ClearPartSelection"/>
        </Border>
      </Canvas>
    </Border>

    <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,15,0,0" LastChildFill="True">
      <Button DockPanel.Dock="Right" Content="Save controller" Click="SaveController" Style="{StaticResource PrimaryButton}"/>
      <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
      <TextBlock x:Name="Status" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
    </DockPanel>
  </Grid>
</Window>
