<Window x:Class="VisualControlsBinder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:games="clr-namespace:VisualControlsBinder.Games"
        Title="VISUAL CONTROL PLANNER" Icon="Brand/VCP.ico" Width="1380" Height="870" MinWidth="960" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style x:Key="ProfileHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <DataTemplate x:Key="ProfileName">
      <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>
  </Window.Resources>
  <Grid Background="{StaticResource WindowBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Padding="24,16,24,14" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
      <StackPanel>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1.55*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image x:Name="BrandTitle" Grid.ColumnSpan="4" Source="Brand/VCP-Title.png" Width="188" HorizontalAlignment="Left"
                 Margin="0,0,0,15" RenderOptions.BitmapScalingMode="HighQuality"
                 AutomationProperties.Name="VCP Visual Control Planner" />
          <DockPanel Grid.Row="1" Margin="0,0,20,0" VerticalAlignment="Top">
            <TextBlock Text="GAME" Style="{StaticResource ProfileHeading}" />
            <ComboBox x:Name="GamePicker" SelectionChanged="GameChanged" AutomationProperties.Name="Game" />
          </DockPanel>
          <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Top">
            <TextBlock Text="OUTPUT" Style="{StaticResource ProfileHeading}" />
            <ComboBox x:Name="RoutePicker" SelectionChanged="OutputChanged" AutomationProperties.Name="Binding output" />
          </DockPanel>
          <Grid Grid.Column="2" Grid.RowSpan="2" Margin="0,0,20,0">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="RoutedGameProfilePanel" Grid.Column="1" VerticalAlignment="Bottom"
                        Visibility="Collapsed" Margin="0,0,0,8">
              <TextBlock Text="GAME BINDING PROFILE" Style="{StaticResource ProfileHeading}" FontSize="11" Margin="0,0,0,3" />
              <Button x:Name="RoutedGameProfileButton" Click="ChooseRoutedGameProfile" ContentTemplate="{StaticResource ProfileName}"
                      AutomationProperties.Name="Choose the game binding profile for vJoy inputs" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="PROFILE" Style="{StaticResource ProfileHeading}" />
            <Button x:Name="SourceButton" Grid.Row="1" Grid.Column="1" Click="ChooseSource" ContentTemplate="{StaticResource ProfileName}"
                    AutomationProperties.Name="Choose source profile" />
            <Button x:Name="NewProfileButton" Grid.Row="1" Grid.Column="2" Content="New…" Click="NewProfile"
                    Margin="7,0,0,0" ToolTip="Create a new profile" AutomationProperties.Name="New profile" />
          </Grid>
          <Button x:Name="GameFilesButton" Grid.Row="1" Grid.Column="3" Content="Game files…" Click="ChooseGameFolder" VerticalAlignment="Top" />
        </Grid>
        <DockPanel x:Name="AircraftRow" Visibility="Collapsed" Margin="0,8,0,0" HorizontalAlignment="Left">
          <TextBlock x:Name="AircraftHeading" Text="AIRCRAFT" Style="{StaticResource ProfileHeading}" />
          <ComboBox x:Name="AircraftPicker" MinWidth="264" SelectionChanged="AircraftChanged" DisplayMemberPath="Name"
                    AutomationProperties.Name="Aircraft" />
        </DockPanel>
        <DockPanel x:Name="DcsProfileRow" Visibility="Collapsed" Margin="0,7,0,0">
          <TextBlock Text="DCS BINDING FILE" Style="{StaticResource ProfileHeading}" />
          <Button x:Name="CopyDcsProfileButton" DockPanel.Dock="Right" Content="Copy path"
                  Click="CopyDcsProfilePath" Margin="8,0,0,0" AutomationProperties.Name="Copy DCS binding file path" />
          <Button x:Name="ChooseDcsProfileButton" DockPanel.Dock="Right" Content="Choose…"
                  Click="ChooseDcsDeviceProfile" Margin="8,0,0,0" AutomationProperties.Name="Choose DCS controller binding file" />
          <TextBlock x:Name="DcsProfileText" Style="{StaticResource SecondaryText}" FontSize="12"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" Padding="24,10">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Vertical" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button x:Name="DeviceLibraryButton" Content="Device library…" Click="AddLibraryDevice" Margin="0,0,0,4" />
          <Button Content="Refresh devices" Click="RefreshDevices" Margin="0,0,0,4" />
          <Button Content="Custom controllers…" Click="EditCustomController" />
        </StackPanel>
        <Grid>
          <ListBox x:Name="DevicePicker" SelectionChanged="DeviceChanged" PreviewMouseWheel="ScrollDeviceStrip"
                   AutomationProperties.Name="Hardware devices" Unloaded="DeviceStripUnloaded" PreviewMouseDown="DeviceStripPointerDown">
          <ListBox.Template>
            <ControlTemplate TargetType="ListBox">
              <ScrollViewer x:Name="DeviceStripScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                            CanContentScroll="False" PanningMode="HorizontalOnly" Focusable="False">
                <ItemsPresenter />
              </ScrollViewer>
            </ControlTemplate>
          </ListBox.Template>
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Width" Value="340" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Margin" Value="0,0,8,0" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Surface" Background="{StaticResource ControlBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" Padding="9,5">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="{StaticResource SelectionBackground}" />
                        <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}" />
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource TextPrimary}" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <Image Source="{Binding Thumbnail}" Width="54" Height="52" Stretch="Uniform" Margin="0,0,9,0" RenderTransformOrigin=".5,.5">
                  <Image.RenderTransform><ScaleTransform ScaleX="{Binding ThumbnailScale}" /></Image.RenderTransform>
                </Image>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                  <Button x:Name="ConnectDeviceButton" Click="ConnectDevice"
                          Content="{Binding ConnectionAction}" AutomationProperties.Name="{Binding ConnectionAutomationName}"
                          ToolTip="{Binding ConnectionDetails}" MinHeight="25" Padding="7,3" FontSize="11" />
                  <Button x:Name="RemoveDeviceButton" Click="RemovePlannedDevice" Content="×" MinHeight="25" MinWidth="24"
                          Padding="3,0" Margin="4,0,0,0" FontSize="15" ToolTip="Remove from plan"
                          AutomationProperties.Name="{Binding RemoveAutomationName}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13" />
                  <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="11" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="EmptyDeviceRoster" Text="Add a controller from the device library to start planning."
                     Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap"
                     Margin="10,4" IsHitTestVisible="False" />
        </Grid>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="390" /></Grid.ColumnDefinitions>
      <Grid Margin="24,14,18,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
          <ComboBox x:Name="ControlPicker" DockPanel.Dock="Right" Width="192" DisplayMemberPath="Name"
                    SelectionChanged="ControlChanged" AutomationProperties.Name="Physical control" />
          <WrapPanel x:Name="ViewTabs" Orientation="Horizontal" />
        </DockPanel>
        <Border Grid.Row="1" Background="{StaticResource CanvasBackground}" CornerRadius="7" ClipToBounds="True">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Canvas x:Name="PhotoCanvas" SizeChanged="PhotoSizeChanged" ClipToBounds="True" Background="Transparent"
                    MouseLeftButtonDown="StartPhotoDrag" MouseMove="MovePhotoDrag" MouseLeftButtonUp="FinishPhotoDrag"
                    LostMouseCapture="CancelPhotoDrag" />
            <Border x:Name="ControlPadPanel" Grid.Column="1" Width="180" Margin="4,12,12,12" Padding="9"
                    VerticalAlignment="Center" Visibility="Collapsed" CornerRadius="9" BorderThickness="1"
                    Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}"
                    AutomationProperties.Name="Hardware control pad">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                 <StackPanel>
                  <DockPanel x:Name="ControlPadSelectionHeader" Visibility="Collapsed" Margin="0,0,0,8">
                    <Button x:Name="ClearPadSelectionButton" DockPanel.Dock="Right" Content="×" Click="ClearPadSelection"
                            Width="27" MinHeight="27" Padding="0" Margin="5,0,0,0" VerticalAlignment="Top"
                            FontSize="17" AutomationProperties.Name="Clear control selection" />
                    <TextBlock x:Name="ControlTitle" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                  </DockPanel>
                  <StackPanel x:Name="ControlPadGestures" Visibility="Collapsed" Margin="0,0,0,8" />
                  <StackPanel x:Name="ControlPadAxes" Visibility="Collapsed" Margin="0,0,0,8">
                    <TextBlock Text="STICK AXES" Style="{StaticResource SecondaryText}" FontSize="10"
                               FontWeight="SemiBold" Margin="3,0,0,4" />
                    <UniformGrid x:Name="ControlPadAxisButtons" Columns="3" />
                  </StackPanel>
                  <Border Background="{StaticResource CanvasBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                          CornerRadius="6" Padding="4">
                    <Grid>
                      <ToggleButton x:Name="ShiftLayerToggle" Content="HARDWARE SHIFT" Checked="ShiftLayerChanged"
                                    Unchecked="ShiftLayerChanged" Height="36" FontSize="14" FontWeight="SemiBold"
                                    Foreground="{StaticResource TextSecondary}" Cursor="Hand"
                                    ToolTip="View the shift layer reported by the controller itself" AutomationProperties.Name="Hardware shift layer">
                        <ToggleButton.Template>
                          <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="ShiftSurface" Background="{StaticResource ControlBackground}"
                                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ShiftSurface" Property="Background" Value="{StaticResource ShiftBackground}" />
                                <Setter TargetName="ShiftSurface" Property="BorderBrush" Value="{StaticResource ShiftAccent}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                <Setter TargetName="ShiftSurface" Property="Effect">
                                  <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource ShiftAccentColor}" BlurRadius="11" ShadowDepth="0" Opacity="0.55" />
                                  </Setter.Value>
                                </Setter>
                              </Trigger>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ShiftSurface" Property="BorderBrush" Value="{StaticResource Accent}" />
                              </Trigger>
                              <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ShiftSurface" Property="BorderBrush" Value="{StaticResource TextPrimary}" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </ToggleButton.Template>
                      </ToggleButton>
                      <StackPanel x:Name="ControlPadModes" Visibility="Collapsed">
                        <TextBlock Text="MODE LAYER" Style="{StaticResource SecondaryText}" FontSize="10"
                                   FontWeight="SemiBold" Margin="3,0,0,4" />
                        <UniformGrid x:Name="ControlPadModeButtons" Columns="5" />
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Button x:Name="GremlinShiftLayerButton" Content="GREMLIN SHIFT" Visibility="Collapsed"
                          Margin="0,5,0,0" Click="ShowGremlinShiftLayer"
                          ToolTip="View the software shift layer entered by your Gremlin modifier" />
                  <StackPanel x:Name="GremlinShiftOptions" Visibility="Collapsed" Margin="0,8,0,0">
                    <TextBlock Text="GREMLIN SHIFT MODIFIER" Style="{StaticResource SecondaryText}" FontSize="10"
                               FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox x:Name="GremlinShiftPicker" AutomationProperties.Name="Gremlin shift modifier"
                              SelectionChanged="GremlinModifierChanged">
                      <ComboBoxItem Content="Regular button" />
                      <ComboBoxItem Content="Hold to shift" />
                      <ComboBoxItem Content="Toggle shift" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel x:Name="ControlPadAssignments" Visibility="Collapsed" Margin="0,8,0,0">
                    <StackPanel x:Name="ControlPadVJoyRoute" Visibility="Collapsed" Margin="0,0,0,7">
                      <TextBlock Text="VJOY ROUTE" Style="{StaticResource SecondaryText}" FontSize="10" FontWeight="SemiBold" />
                      <TextBlock x:Name="VJoyRouteSummary" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                 AutomationProperties.Name="Effective vJoy route" />
                    </StackPanel>
                    <UniformGrid x:Name="ActivationButtons" Rows="1" Margin="0,0,0,7" Visibility="Collapsed">
                      <UniformGrid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                          <Setter Property="Margin" Value="0,0,3,0" />
                          <Setter Property="Padding" Value="2,4" />
                          <Setter Property="MinHeight" Value="26" />
                          <Setter Property="FontSize" Value="10" />
                        </Style>
                      </UniformGrid.Resources>
                      <Button x:Name="DefaultActivationButton" Content="DEFAULT" Tag="{x:Static games:BindingActivation.Default}"
                              Click="SelectBindingActivation" />
                      <Button Content="TAP" Tag="{x:Static games:BindingActivation.Tap}" Click="SelectBindingActivation" />
                      <Button Content="DOUBLE TAP" Tag="{x:Static games:BindingActivation.DoubleTap}" Click="SelectBindingActivation" />
                      <Button Content="HOLD" Tag="{x:Static games:BindingActivation.Hold}" Click="SelectBindingActivation" Margin="0" />
                    </UniformGrid>
                    <DockPanel>
                      <Button x:Name="RemoveButton" DockPanel.Dock="Right" Content="Unassign" Click="RemoveAssignment"
                              IsEnabled="False" MinHeight="25" FontSize="11" Padding="5,2" Margin="5,0,0,0"
                              ToolTipService.ShowOnDisabled="True" />
                      <TextBlock Text="CURRENT BINDINGS" Style="{StaticResource SecondaryText}"
                                 FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="AssignmentPicker" MaxHeight="96" SelectionChanged="AssignmentSelectionChanged"
                             AutomationProperties.Name="Current bindings">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel AutomationProperties.Name="{Binding Label}">
                            <StackPanel.ToolTip>
                              <ToolTip Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}">
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="340" />
                              </ToolTip>
                            </StackPanel.ToolTip>
                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold"
                                       LineHeight="15" MaxHeight="30" LineStackingStrategy="BlockLineHeight"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Title}" Value="">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Entry}" FontSize="13" FontWeight="Normal" Margin="0,2,0,0"
                                       LineHeight="17" MaxHeight="34" LineStackingStrategy="BlockLineHeight"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="AssignmentEmpty" Text="No bindings assigned." FontSize="12" Margin="0,4,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=AssignmentPicker}" Value="False">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                  <TextBlock x:Name="InputSummary" Style="{StaticResource SecondaryText}" FontSize="12"
                             Margin="0,8,0,4" />
                  <WrapPanel x:Name="ControlPadInputButtons" Visibility="Collapsed">
                    <Button x:Name="LearnButton" Content="Learn this control" Click="LearnInput" IsEnabled="False" Margin="0,0,5,0" />
                    <Button x:Name="ManualInputButton" Content="…" Click="ChooseInput" IsEnabled="False"
                            ToolTip="Set input manually" AutomationProperties.Name="Set input manually" />
                  </WrapPanel>
                  <StackPanel Visibility="Collapsed">
                    <DockPanel x:Name="GestureRow">
                      <ComboBox x:Name="GesturePicker" DisplayMemberPath="Name" SelectionChanged="GestureChanged" />
                    </DockPanel>
                    <ComboBox x:Name="LayerPicker" SelectionChanged="LayerChanged" />
                  </StackPanel>
                 </StackPanel>
                </ScrollViewer>
                <WrapPanel Grid.Row="1" Margin="0,6,0,0">
                  <Button x:Name="GuidedLearnButton" Content="Input Configurator" Click="ToggleGuidedLearn" Margin="0,0,5,0"
                          ToolTip="Walk through each unlearned control on the selected controller and hardware layer" />
                  <Button x:Name="BackGuidedInputButton" Content="Back" Click="BackGuidedInput" Visibility="Collapsed"
                          Margin="0,0,5,0" ToolTip="Undo the previous sweep step" />
                  <Button x:Name="SkipGuidedInputButton" Content="Skip input" Click="SkipGuidedInput" Visibility="Collapsed" />
                </WrapPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Column="1" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1,0,0,0" Padding="20,18,20,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <StackPanel x:Name="VirtualRoutingPanel" Margin="0,0,0,10" Visibility="Collapsed">
              <DockPanel Margin="0,0,0,5">
                <Button x:Name="AutoMapInputsButton" DockPanel.Dock="Right" Content="Auto-map inputs…" Click="AutoMapInputs"
                        ToolTip="Map known buttons and fill unused vJoy axes in device-strip order." Margin="7,0,0,0" />
                <Button x:Name="PatchBayButton" DockPanel.Dock="Right" Content="Patch bay…" Click="OpenPatchBay" Margin="7,0,0,0" />
                <TextBlock Text="VJOY OUTPUT" Style="{StaticResource SecondaryText}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="VJoyDevicePicker" SelectionChanged="VJoyDeviceChanged" DisplayMemberPath="Label"
                          Margin="0,0,7,0" AutomationProperties.Name="vJoy device" />
                <ComboBox x:Name="VJoyInputPicker" Grid.Column="1" SelectionChanged="VJoyInputChanged"
                          DisplayMemberPath="Label" AutomationProperties.Name="vJoy button or axis" />
              </Grid>
              <TextBlock x:Name="VirtualRoutingHint" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
            <DockPanel x:Name="NativeJoystickPanel" Visibility="Collapsed" Margin="0,0,0,10">
              <Button x:Name="ChooseNativeJoystickButton" DockPanel.Dock="Right" Content="Use this device" Click="ChooseNativeJoystick" Margin="7,0,0,0" />
              <TextBlock x:Name="NativeJoystickHint" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" FontSize="11" />
            </DockPanel>
          </StackPanel>
          <DockPanel Grid.Row="1" Margin="0,3,0,6">
            <Grid>
              <TextBox x:Name="ActionSearch" TextChanged="ActionSearchChanged" AutomationProperties.Name="Search game actions" ToolTip="Search action names or in-game categories" />
              <TextBlock Text="Search game actions" IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ActionSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DockPanel>
          <ListBox x:Name="ActionPicker" Grid.Row="2" SelectionChanged="ActionSelectionChanged" MouseDoubleClick="ActionDoubleClicked" MinHeight="100" AutomationProperties.Name="Game actions"
                   VirtualizingPanel.IsVirtualizingWhenGrouping="True" ScrollViewer.CanContentScroll="True">
            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="7,5" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="RowSurface" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="RowSurface" Property="Background" Value="{StaticResource HoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="RowSurface" Property="Background" Value="{StaticResource SelectionBackground}" />
                          <Setter TargetName="RowSurface" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                          <Setter TargetName="RowSurface" Property="BorderBrush" Value="{StaticResource Accent}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.ContainerStyle>
                  <Style TargetType="GroupItem">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                          <Expander Header="{Binding Name}" IsExpanded="False" Margin="0,5,0,2"
                                    AutomationProperties.Name="{Binding Name}"
                                    Loaded="ActionGroupLoaded" DataContextChanged="ActionGroupContextChanged"
                                    Expanded="ActionGroupToggled" Collapsed="ActionGroupToggled">
                            <Expander.Template>
                              <ControlTemplate TargetType="Expander">
                                <StackPanel>
                                  <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}"
                                                AutomationProperties.Name="{TemplateBinding Header}"
                                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                MouseDoubleClick="ActionGroupHeaderDoubleClicked">
                                    <ToggleButton.Template>
                                      <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderSurface" Background="{StaticResource ControlBackground}"
                                                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                          <DockPanel>
                                            <Path x:Name="Chevron" Data="M 2 1 L 6 5 L 2 9" Stroke="{StaticResource Accent}"
                                                  StrokeThickness="1.5" Width="9" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{TemplateBinding Content}" Foreground="{StaticResource Accent}"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                                          </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                          <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="Data" Value="M 1 3 L 5 7 L 9 3" />
                                          </Trigger>
                                          <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{StaticResource Accent}" />
                                          </Trigger>
                                          <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{StaticResource TextPrimary}" />
                                          </Trigger>
                                        </ControlTemplate.Triggers>
                                      </ControlTemplate>
                                    </ToggleButton.Template>
                                  </ToggleButton>
                                  <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Expander.Template>
                            <ItemsPresenter />
                          </Expander>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </GroupStyle.ContainerStyle>
              </GroupStyle>
            </ListBox.GroupStyle>
          </ListBox>
          <Button x:Name="AssignButton" Grid.Row="3" Content="Assign selected action" Click="AddAssignment" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" IsEnabled="False" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Padding="24,10" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource SecondaryText}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="DiagramButton" Content="Binding diagram…" Click="OpenDiagram" Margin="0,0,8,0" />
          <Button Content="New plan" Click="NewPlan" Margin="0,0,8,0" />
          <Button Content="Open plan…" Click="OpenPlan" Margin="0,0,8,0" />
          <Button Content="Save plan…" Click="SavePlan" Margin="0,0,8,0"
                  ToolTip="Save your working plan with local paths and device pairings." />
          <Button Content="Share plan…" Click="SharePlan" Margin="0,0,8,0"
                  ToolTip="Save a copy without local paths or device pairings." />
          <Button Content="Preview / export…" Click="PreviewExport" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
